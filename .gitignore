# ─── Dependências ─────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js / build ──────────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ─── Testes ───────────────────────────────────────────────────
/coverage
/playwright-report/
/test-results/

# ─── Variáveis de ambiente ────────────────────────────────────
# Nada de segredos no repositório. O .env.example é a documentação
# das variáveis e precisa continuar versionado.
.env*
!.env.example

# ─── Deploy ───────────────────────────────────────────────────
.vercel

# ─── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Sistema operacional ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ─── Editores ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.suo

# ─── Certificados / chaves ────────────────────────────────────
*.pem
*.key

# ─── Skills de IA (npx skills add) ────────────────────────────
# O skills-lock.json fica versionado: registra origem e hash de cada skill.
# As pastas instaladas ficam de fora: .claude/skills contém symlinks com
# caminho absoluto da máquina (quebram em outro computador) e .agents traz
# conteúdo de terceiros. Para reinstalar, veja a seção "Skills" do README.
/.agents/
/.claude/skills/
/.claude/settings.local.json
