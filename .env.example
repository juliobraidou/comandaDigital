# URL pública do site — usada em metadataBase, Open Graph, sitemap e JSON-LD.
# Sem ela, tudo cai para http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://comandadigital.com.br

# Libera a indexação pelos buscadores. Defina como "true" APENAS no ambiente
# de produção. Sem isso, o site responde noindex e robots.txt com Disallow: /,
# evitando que deploys de preview/staging entrem no Google.
NEXT_PUBLIC_ALLOW_INDEXING=false
